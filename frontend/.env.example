# =============================================================================
#  Frontend (React/CRA) - variabel BUILD-TIME, bukan runtime.
#  Salin ke frontend/.env untuk pengembangan lokal.
# =============================================================================

# URL backend. KOSONGKAN pada image Docker/produksi agar frontend memanggil
# /api pada domain yang sama. Isi hanya saat `yarn start` lokal atau bila API
# berada di domain lain. Contoh lokal: http://localhost:8001
REACT_APP_BACKEND_URL=

# Khusus dev server (opsional)
WDS_SOCKET_PORT=443
ENABLE_HEALTH_CHECK=false
