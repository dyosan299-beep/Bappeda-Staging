# =============================================================================
#  Backend - template environment untuk DEV LOKAL
#  Salin:  cp backend/.env.example backend/.env
#
#  Template untuk Coolify / produksi ada di .env.example (root repo).
#  Yang ini sengaja beda pada beberapa nilai (HOST, PORT, COOKIE_SECURE,
#  path data) supaya dev di laptop tidak butuh Docker dan tidak gagal login.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. DATABASE (WAJIB)
# -----------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sidata
DB_USERNAME=root
DB_PASSWORD=

# -----------------------------------------------------------------------------
# 2. SERVER LOKAL
# -----------------------------------------------------------------------------
# Pakai 127.0.0.1, JANGAN "localhost". Di Windows, localhost bisa resolve ke ::1
# sehingga server hanya listen IPv6 dan http://127.0.0.1:PORT tidak bisa dibuka.
HOST=127.0.0.1
PORT=8001
TZ=Asia/Makassar

# Biarkan kosong saat dev: frontend dilayani dev server CRA di :3000.
# Bila diisi dan index.html tidak ada, backend otomatis mode API saja.
# FRONTEND_BUILD_DIR=

# -----------------------------------------------------------------------------
# 3. AUTENTIKASI (WAJIB)
# -----------------------------------------------------------------------------
# Buat dengan: openssl rand -hex 48
JWT_SECRET=

ADMIN_EMAIL=admin@bappeda.makassarkota.go.id
ADMIN_PASSWORD=

# WAJIB false untuk http://localhost. Default di kode adalah "true", dan dengan
# secure=true cookie sesi tidak dikirim browser lewat HTTP biasa: login tampak
# berhasil tetapi setiap request berikutnya 401.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# 4. VERVAL / CRON WEBHOOK
# -----------------------------------------------------------------------------
# openssl rand -hex 32 - JANGAN diganti setelah data Verval produksi ada.
VERVAL_REF_SECRET=
WEBHOOK_CRON_SECRET=
APP_PUBLIC_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# 5. IMPORT DATA (opsional)
# -----------------------------------------------------------------------------
# Default di kode memakai path Linux container (mis. /app/data_upload/...),
# jadi untuk dev lokal arahkan ke folder repo.
# IMPORT_MAX_UPLOAD_MB=100
# DATA_UPLOAD_DIR=./data_upload
# INKLUSI_DATA_DIR=./data_upload/inklusi

# Foto Verval: HARUS path absolut & writable. Bila kosong, unggah foto ditolak 503.
# VERVAL_STORAGE_DIR=./data_upload/verval

# -----------------------------------------------------------------------------
# 6. INTEGRASI LLM (opsional saat dev)
# -----------------------------------------------------------------------------
HOSTLINKU_API_KEY=
# HOSTLINKU_BASE_URL=https://api.hostlinku.com/v1
# HOSTLINKU_MODEL=deepseek-v4-1-flash
# AI_DEFAULT_MODEL=deepseek-v4-1-flash

# Google Maps (opsional; bila kosong peta memakai Leaflet/OSM)
# GOOGLE_MAPS_API_KEY=

# -----------------------------------------------------------------------------
# 7. EMAIL NOTIFIKASI (opsional; bila kosong email hanya diantrikan)
# -----------------------------------------------------------------------------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURITY=
# SMTP_FROM="PETA INKLUSI <noreply@example.go.id>"

# -----------------------------------------------------------------------------
# 8. AKUN DEMO - HANYA untuk lokal. JANGAN aktifkan di produksi.
# -----------------------------------------------------------------------------
SEED_DEMO_USERS=false
