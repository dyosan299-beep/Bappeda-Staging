# =============================================================================
#  PETA INKLUSI / SIDATA Bappeda Kota Makassar - Template Environment Variables
#  Salin ke Coolify > Application > Environment Variables (atau backend/.env
#  untuk lokal), lalu isi nilainya.
#  JANGAN commit file .env yang sudah terisi kredensial nyata.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. DATABASE - MariaDB (WAJIB)
# -----------------------------------------------------------------------------
# Bila aplikasi & database berada di project Coolify yang sama, boleh memakai
# hostname internal container MariaDB.
DB_HOST=
DB_PORT=3306
DB_DATABASE=default
DB_USERNAME=mariadb
DB_PASSWORD=

# OPSIONAL - alternatif satu baris (juga dibaca dari DB_URL / MYSQL_URL).
# Bila diisi, bagian yang kosong di atas diambil dari sini.
# Skema: mysql:// mariadb:// mysql+aiomysql://
# Contoh: mysql://<user>:<password>@<host>:<port>/<database>
# DATABASE_URL=

# Warisan template platform (tidak dipakai kode; aplikasi memakai MariaDB).
# DB_NAME=
# MONGO_URL=

# -----------------------------------------------------------------------------
# 2. SERVER
# -----------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
WEB_CONCURRENCY=2
TZ=Asia/Makassar

# Lokasi build React yang disajikan backend (default Dockerfile repo ini).
FRONTEND_BUILD_DIR=/srv/frontend/build

# -----------------------------------------------------------------------------
# 3. KEAMANAN / AUTENTIKASI (WAJIB)
# -----------------------------------------------------------------------------
# Rahasia penandatangan JWT. Buat dengan: openssl rand -hex 48
JWT_SECRET=

# Akun superadmin awal (di-seed otomatis & idempotent saat aplikasi start).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cookie sesi.
#   Satu domain (frontend + API satu origin), HTTPS  -> secure=true, samesite=lax
#   Frontend dan API di domain BERBEDA               -> secure=true, samesite=none
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Origin yang diizinkan, dipisah koma. Contoh: https://domain-anda.go.id
CORS_ORIGINS=

# -----------------------------------------------------------------------------
# 4. INTEGRASI
# -----------------------------------------------------------------------------
# Hostlinku - gateway AI kompatibel OpenAI (AI Assistant + Analisa AI).
# Buat API key di https://console.hostlinku.com (bayar PAYG, isi saldo via QRIS/VA).
# Dokumentasi: https://docs.hostlinku.com/docs
HOSTLINKU_API_KEY=
# Opsional - default sudah sesuai:
# HOSTLINKU_BASE_URL=https://api.hostlinku.com/v1
# HOSTLINKU_MODEL=deepseek-v4-1-flash      (termurah; alternatif: deepseek-v4-pro, qwen3-6-plus)
# HOSTLINKU_MAX_TOKENS=4000                (model DeepSeek V4 = reasoning; token berpikir ikut dihitung)
# AI_DEFAULT_MODEL=deepseek-v4-1-flash     (model awal di dropdown AI Assistant)
# Catatan: Text-to-Speech memakai suara browser (Hostlinku belum menyediakan audio).

# Google Maps JavaScript API key (opsional; bila kosong peta memakai Leaflet/OSM).
GOOGLE_MAPS_API_KEY=

# -----------------------------------------------------------------------------
# 5. EMAIL NOTIFIKASI NGO (SMTP) - opsional; bila kosong email hanya diantrikan
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# ssl | starttls | none (default: ssl bila port 465, selain itu starttls)
SMTP_SECURITY=
SMTP_FROM="PETA INKLUSI <noreply@example.go.id>"
# URL publik aplikasi, dipakai untuk tautan di email. Contoh: https://domain-anda.go.id
APP_PUBLIC_URL=

# -----------------------------------------------------------------------------
# 6. IMPORT DATA (opsional, default sudah sesuai)
# -----------------------------------------------------------------------------
IMPORT_MAX_UPLOAD_MB=100
# DATA_UPLOAD_DIR=/app/data_upload/Bahan Website Ibu Kabid
# INKLUSI_DATA_DIR=/app/data_upload/inklusi

# -----------------------------------------------------------------------------
# 7. AKUN DEMO (HANYA preview/pengembangan - JANGAN aktifkan di produksi)
# -----------------------------------------------------------------------------
# SEED_DEMO_USERS=false
# DEMO_PETUGAS_PASSWORD=
# DEMO_OPERATOR_PASSWORD=
# DEMO_VERIFIKATOR_PASSWORD=

# -----------------------------------------------------------------------------
# 8. KHUSUS docker-compose.yml lokal
# -----------------------------------------------------------------------------
# MARIADB_ROOT_PASSWORD=

# -----------------------------------------------------------------------------
# 9. KHUSUS skrip pengujian (tests/*.py) - diekspor di shell, bukan di Coolify
# -----------------------------------------------------------------------------
# TEST_ADMIN_PASSWORD=
# TEST_PETUGAS_PASSWORD=
# TEST_OPERATOR_PASSWORD=
# TEST_VERIFIKATOR_PASSWORD=
# TEST_NGO_PASSWORD=

# 6. RINGKASAN MINGGUAN PIMPINAN (cron Senin 06.00 WITA, lihat .emergent/crons.yml)
# Rahasia untuk endpoint /api/cron/ringkasan-mingguan (string acak 32+ karakter)
WEBHOOK_CRON_SECRET=
# Penerima tambahan (opsional, pisahkan dengan koma)
WEEKLY_SUMMARY_EXTRA_RECIPIENTS=

# 10. GEOTAG-VERVAL DTSEN (Operator RT/RW)
# Rahasia HMAC referensi stabil DTSEN (no_kk + kode_kelurahan). WAJIB, 64 hex. JANGAN diganti
# setelah produksi berjalan (seluruh relasi Verval bergantung padanya). Buat: openssl rand -hex 32
VERVAL_REF_SECRET=
# Direktori foto Verval pada VOLUME PERSISTEN Coolify (path absolut, owner UID 10001)
VERVAL_STORAGE_DIR=/srv/verval
# Target akurasi GPS (meter) dan kebijakan bila tidak terpenuhi
VERVAL_GPS_MAX_AKURASI_M=5
VERVAL_IZINKAN_KIRIM_TANPA_GPS=false
VERVAL_MAX_FOTO_MB=8
VERVAL_MAX_FOTO_PER_VERVAL=6
VERVAL_MIN_FOTO=1
# HANYA preview/pengujian: izinkan skrip scripts/verval_data_uji.py (JANGAN aktif di produksi)
# VERVAL_IZINKAN_DATA_UJI=false
# Password untuk akun UJI sintetis (WAJIB di-set saat menjalankan scripts/verval_data_uji.py).
# Jangan pakai di produksi.
# VERVAL_UJI_PASSWORD=
